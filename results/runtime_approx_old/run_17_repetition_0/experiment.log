&= -\frac{1}{x^2}\frac{1}{y^2}\frac{\partial^2 u}{\partial x^2} \\
&= -\frac{1}{x^2}\frac{1}{y^2}\frac{1}{x^2}\frac{\partial^2 u}{\partial y^2} \\
&= -\frac{1}{x^2}\frac{1}{y^2}\frac{1}{y^2}\frac{\partial^2 u}{\partial y^2} \\
&= -\frac{1}{x^2}\frac{1}{y^2}\frac{1}{y^2}\frac{1}{x^2}\frac{\partial^2 u}{\partial y^2} \\
&= -\frac{1}{x^2}\frac{1}{y^2}\frac{1}{x^2}\frac{\partial^2 u}{\partial y^2} \\
