y & 1 & 8
\end{bmatrix}
$$

The determinant for this system is:

$$
D_x = y \cdot (4 \cdot 8 - 4 \cdot 1) - 1 \cdot (1 \cdot 8 - 4 \cdot y) + z \cdot (4 \cdot 1 - 1 \cdot 4)
$$

$$
D_x = y \cdot (32 - 4) - 1 \cdot (8 - 4y) + z \cdot (4 - 4)
$$

$$
D_x = 28y - 4y + 4z
$$

Now, let's replace the second variable y with a column vector [x; y; z]:

$$
\begin{bmatrix}
x & 1 & z \\
x & 4 & 4 \\
x & 1 & 8
\end{bmatrix}
$$

The determinant for this system is:

$$
D_y = x \cdot (4 \cdot 8 - 4 \cdot 1) - 1 \cdot (1 \cdot 8 - 4 \cdot x) + z \cdot (4 \cdot 1 - 1 \cdot 4)
$$

$$
D_y = 8x - 4x + 4z
$$

$$
D_y = 4x + 4z
$$

Finally, let's replace the third variable z with a column vector [x; y; z]:

$$
\begin{bmatrix}
x & y & 1 \\
x & y & 4 \\
x & y & 1
\end{bmatrix}
$$

The determinant for this system is:

$$
D_z = x \cdot (y \cdot 1 - 4 \cdot 1) - y \cdot (x \cdot 1 - 4 \cdot 1) + 1 \cdot (x \cdot 4 - y \cdot 1)
